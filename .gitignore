# -------------------------------
# AgriMALL — Philippine Agribusiness Marketplace
# -------------------------------

# --- Local configuration (contains credentials) ---
# Never commit real credentials. Copy config.example.php over config.php locally.
config/config.php

# --- Uploaded user content ---
# Keep the directory empty, but the upload guard must stay versioned: it is
# what stops Apache from executing a .php file a user managed to upload.
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/.htaccess
# Listing images live one level down. Keep that directory in the clone too: an
# absent destination made move_uploaded_file() fail and every upload 500.
# listing_upload_dir() also creates it at runtime, belt and braces.
!public/uploads/listings/
# Re-exclude its contents: the line above re-includes the directory, and without
# this a stray uploaded image gets committed.
public/uploads/listings/*
!public/uploads/listings/.gitkeep

# --- Runtime logs ---
logs/*
!logs/.gitkeep

# --- Generated accessibility report ---
# Written by tests/axe-audit.js on every run. A committed copy goes stale
# immediately and reads as evidence for a run nobody can reproduce.
tests/axe-report.json

# --- Automated database backups ---
# Written by tools/backup.php; never commit a dump.
backups/

# --- Editors & OS junk ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Tooling artifacts ---
.hallmark/
.impeccable/
node_modules/
public/assets/dist/

# --- PHP specifics ---
*.log

# --- Local-only working files ---
# AGENTS.md and scratch/probe files are mine, not the project's; keep them
# out of the repo. Generic globs (not one-off filenames) so regenerated
# debris is still caught.
AGENTS.md
*.tmp.js
*.bak
*PROMPT*.txt
*Prompt*.txt
*Overhaul*.txt
*.prompt.txt
# Scratchpad (temp artifacts, probes, one-shot scripts)
scratchpad/
