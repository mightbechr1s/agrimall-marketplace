{
  "name": "animal-marketplace",
  "version": "1.0.0",
  "description": "AgriMALL - Philippine Agribusiness Marketplace",
  "private": true,
  "scripts": {
    "build:assets": "esbuild public/assets/css/styles.css --minify --outfile=public/assets/css/styles.min.css && esbuild public/assets/css/motion.css --minify --outfile=public/assets/css/motion.min.css && esbuild public/assets/js/motion.js --minify --outfile=public/assets/js/motion.min.js && esbuild public/assets/js/swipe.js --minify --outfile=public/assets/js/swipe.min.js",
    "build:islands": "vite build",
    "lint:php": "php tests/lint.php",
    "test": "npm run lint:php && npm run test:i18n && npm run test:validation && npm run test:pdf && npm run test:security && npm run test:docs",
    "test:security": "php tests/security_test.php",
    "test:docs": "php tests/docs_test.php",
    "test:i18n": "php tests/i18n-parity.php",
    "test:validation": "php tests/validation.php",
    "test:pdf": "php tests/pdf_test.php",
    "test:http": "powershell -ExecutionPolicy Bypass -File tests/http_test.ps1",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File tests/e2e_test.ps1",
    "test:toast": "node tests/e2e/toast_test.js",
    "test:cart": "node tests/e2e/cart_pill_test.js",
    "test:panels": "powershell -ExecutionPolicy Bypass -File tests/panels_test.ps1",
    "test:layout": "powershell -ExecutionPolicy Bypass -File tests/layout_test.ps1",
    "dev": "php -S 127.0.0.1:8000 -t public public/router.php"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}
